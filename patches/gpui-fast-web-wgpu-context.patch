--- /dev/null
+++ b/crates/gpui_web/src/fast/mod.rs
@@ -0,0 +1,14 @@
+//! gpui-fast's additions to the web platform.
+
+use gpui_wgpu::WgpuContext;
+
+use crate::WebPlatform;
+
+impl WebPlatform {
+    /// The context drawing this platform's window, once graphics have been
+    /// initialized: from the moment the application finishes launching. Lets
+    /// an application allocate a `WgpuDynamicTexture` that GPUI can sample.
+    pub fn wgpu_context(&self) -> Option<WgpuContext> {
+        self.wgpu_context.borrow().clone()
+    }
+}
